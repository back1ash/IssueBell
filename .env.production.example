# 이 파일을 .env.production으로 복사한 후 실제 운영 값을 입력합니다.
# .env.production은 Git에 커밋하지 않습니다.
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
SECURE_COOKIES=true
SESSION_MAX_AGE=1209600
ALLOWED_HOSTS=issuebell.com
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://issuebell.com/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://issuebell.com/auth/github/callback
OAUTH_HTTP_TIMEOUT=10
OAUTH_STATE_MAX_AGE=600
OUTBOUND_HTTP_TIMEOUT=15
POLL_INTERVAL=180
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg2://issuebell:CHANGE_ME@postgres:5432/issuebell
