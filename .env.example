# ─── App ──────────────────────────────────────────────────────────────────────
# Generate unique, random values for production. Keep TOKEN_ENCRYPTION_KEY stable
# when rotating SECRET_KEY so existing GitHub connections remain decryptable.
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=change-me-to-a-different-long-random-string
SECURE_COOKIES=false
SESSION_MAX_AGE=1209600
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///./issuebell.db

# ─── Discord ───────────────────────────────────────────────────────────────────
# Bot token (Discord Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=

# OAuth2 credentials (Discord Developer Portal → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The exact callback URL registered with Discord.
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Network and OAuth safeguards
OAUTH_HTTP_TIMEOUT=10
OAUTH_STATE_MAX_AGE=600
OUTBOUND_HTTP_TIMEOUT=15

# How often (seconds) to poll GitHub for matching issue updates (default 180 = 3 min)
POLL_INTERVAL=180
